<Window x:Class="MobCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MobCam" Width="1140" Height="720" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Segmented buttons: radio buttons that look like toggle buttons -->
        <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Left: header, preview, stats -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <Border DockPanel.Dock="Right" CornerRadius="14" Padding="12,5" VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="StateText" Text="Not connected" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="LogoImage" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="MobCam" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" CornerRadius="10" Background="#FF0B0C0E" ClipToBounds="True">
                <Grid>
                    <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel x:Name="Overlay" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <TextBlock x:Name="OverlayIcon" Style="{StaticResource Icon}" Text="&#xE8EA;" FontSize="46"
                                   HorizontalAlignment="Center" Foreground="#99FFFFFF" />
                        <TextBlock x:Name="OverlayTitle" Text="Not connected" FontSize="19" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,14,0,6" />
                        <TextBlock x:Name="OverlayText" Foreground="#B3FFFFFF" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Open the MobCam app on your phone, then click Connect." />
                        <ProgressBar x:Name="OverlayProgress" IsIndeterminate="True" Width="180" Margin="0,18,0,0"
                                     Visibility="Collapsed" />
                        <!-- Two-sided pairing: this PC's user confirms the code too -->
                        <StackPanel x:Name="PairingButtons" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,20,0,0" Visibility="Collapsed">
                            <Button x:Name="PairMatchButton" Content="Codes match" Style="{DynamicResource AccentButtonStyle}"
                                    Padding="18,7" Margin="0,0,10,0" Click="OnPairMatch" />
                            <Button x:Name="PairCancelButton" Content="Cancel" Padding="18,7" Click="OnPairCancel" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="2,12,2,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Ellipse x:Name="InUseDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                             Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="InUseText" Style="{StaticResource Caption}" Text="No app is using the camera" />
                </StackPanel>
                <TextBlock x:Name="Stats" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <!-- ============================== Right: controls -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>

                <!-- Virtual camera -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="VcamIcon" Style="{StaticResource Icon}" Text="&#xE714;" FontSize="18"
                                       Margin="0,0,12,0" />
                            <StackPanel>
                                <TextBlock Text="Virtual camera" FontWeight="SemiBold" />
                                <TextBlock x:Name="VcamText" Style="{StaticResource Caption}" Text="Checking…" />
                            </StackPanel>
                        </DockPanel>
                        <Button x:Name="VcamButton" Content="Install" Style="{DynamicResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="OnVcamButton" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Connection -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeAuto" GroupName="Mode" Style="{StaticResource Segment}" Click="OnModeClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" Margin="0,0,6,0" />
                                    <TextBlock Text="Auto" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeUsb" GroupName="Mode" Style="{StaticResource Segment}" Click="OnModeClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" Margin="0,0,6,0" />
                                    <TextBlock Text="USB" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeWifi" GroupName="Mode" Style="{StaticResource Segment}" Click="OnModeClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" Margin="0,0,6,0" />
                                    <TextBlock Text="Wi-Fi" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <TextBlock x:Name="ModeHint" Style="{StaticResource Caption}" Margin="0,8,0,0" />

                        <StackPanel x:Name="HostPanel" Visibility="Collapsed">
                            <TextBlock Text="Phone address (leave empty to search)" Style="{StaticResource Label}" />
                            <TextBox x:Name="HostBox" />
                        </StackPanel>

                        <DockPanel Margin="0,14,0,6">
                            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="7,3" Click="OnRefresh"
                                    ToolTip="Search for phones again">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                            </Button>
                            <TextBlock Text="Phones nearby" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}" Click="OnDeviceClick" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="10,7" Margin="0,0,0,4"
                                            ToolTip="Connect to this phone">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}"
                                                       Text="{Binding Glyph}" FontSize="16" Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}"
                                                       Text="{Binding StateGlyph}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoDevicesText" Style="{StaticResource Caption}" Margin="2,2,0,0"
                                   Text="Searching… open the MobCam app on your phone." />

                        <Button x:Name="ConnectButton" Content="Connect" Style="{DynamicResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,14,0,0" Padding="0,7" Click="OnConnectClick" />
                    </StackPanel>
                </Border>

                <!-- Phone remote control -->
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="PhonePanel">
                        <TextBlock Text="Phone camera" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="LensTitle" Text="Lens" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <!-- Filled from the phone's lens list: ultra-wide, wide, telephoto, front... -->
                        <WrapPanel x:Name="LensPanel" />
                        <StackPanel x:Name="FacingPanel" Orientation="Horizontal">
                            <RadioButton x:Name="FacingBack" GroupName="Facing" Content="Back" Style="{StaticResource Segment}" Click="OnFacingClick" />
                            <RadioButton x:Name="FacingFront" GroupName="Facing" Content="Front (selfie)" Style="{StaticResource Segment}" Click="OnFacingClick" />
                        </StackPanel>
                        <TextBlock Text="Quality" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Res480" GroupName="Res" Content="480p" Tag="480" Style="{StaticResource Segment}" Click="OnResolutionClick" />
                            <RadioButton x:Name="Res720" GroupName="Res" Content="720p" Tag="720" Style="{StaticResource Segment}" Click="OnResolutionClick" />
                            <RadioButton x:Name="Res1080" GroupName="Res" Content="1080p" Tag="1080" Style="{StaticResource Segment}" Click="OnResolutionClick" />
                        </StackPanel>
                        <TextBlock x:Name="PhoneHint" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Text="Connect a phone to control its camera from here." />
                    </StackPanel>
                </Border>

                <!-- Picture -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Picture" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Rotation" Style="{StaticResource Label}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RotAuto" GroupName="Rot" Content="Auto" Tag="-1" Style="{StaticResource Segment}" Click="OnRotationClick" />
                            <RadioButton x:Name="Rot0" GroupName="Rot" Content="0°" Tag="0" Style="{StaticResource Segment}" Click="OnRotationClick" />
                            <RadioButton x:Name="Rot90" GroupName="Rot" Content="90°" Tag="90" Style="{StaticResource Segment}" Click="OnRotationClick" />
                            <RadioButton x:Name="Rot180" GroupName="Rot" Content="180°" Tag="180" Style="{StaticResource Segment}" Click="OnRotationClick" />
                            <RadioButton x:Name="Rot270" GroupName="Rot" Content="270°" Tag="270" Style="{StaticResource Segment}" Click="OnRotationClick" />
                        </StackPanel>
                        <TextBlock Text="Framing" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FrameFit" GroupName="Frame" Content="Fit" Style="{StaticResource Segment}" Click="OnFramingClick" />
                            <RadioButton x:Name="FrameFill" GroupName="Frame" Content="Fill" Style="{StaticResource Segment}" Click="OnFramingClick" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="Fit shows the whole picture with bars; Fill crops it to cover the frame." />
                    </StackPanel>
                </Border>

                <!-- App -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="App" Style="{StaticResource CardTitle}" />
                        <CheckBox x:Name="AutoConnectBox" Content="Connect automatically when MobCam starts" Click="OnAppOptionClick" />
                        <CheckBox x:Name="StartupBox" Content="Start with Windows (in the tray)" Click="OnAppOptionClick" Margin="0,6,0,0" />
                        <CheckBox x:Name="TrayBox" Content="Keep running in the tray when closed" Click="OnAppOptionClick" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Caption}" Margin="4,0,4,8"
                           Text="Pick “MobCam” as the camera in Zoom, Teams, Meet, OBS or the Windows Camera app." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
