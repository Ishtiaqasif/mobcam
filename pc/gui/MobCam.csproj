<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for the tray icon -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MobCam</AssemblyName>
    <RootNamespace>MobCam</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Fluent ThemeMode is still marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Version>1.0.0</Version>
    <Product>MobCam</Product>
    <ApplicationIcon>mobcam.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="mobcam.ico" />
  </ItemGroup>

  <!-- Build info shown in the app (window title / App card): git commit and whether the working
       tree had uncommitted changes, so two builds of the same version can be told apart. -->
  <Target Name="MobCamBuildInfo" BeforeTargets="GetAssemblyAttributes;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="MobCamCommit" />
    </Exec>
    <Exec Command="git status --porcelain" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="MobCamGitStatus" />
    </Exec>
    <PropertyGroup>
      <MobCamModified>false</MobCamModified>
      <MobCamModified Condition="'$(MobCamGitStatus)' != ''">true</MobCamModified>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Commit</_Parameter1>
        <_Parameter2>$(MobCamCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Modified</_Parameter1>
        <_Parameter2>$(MobCamModified)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
