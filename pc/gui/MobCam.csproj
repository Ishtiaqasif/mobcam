<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for the tray icon -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MobCam</AssemblyName>
    <RootNamespace>MobCam</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Fluent ThemeMode is still marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Version>1.0.0</Version>
    <Product>MobCam</Product>
    <ApplicationIcon>mobcam.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="mobcam.ico" />
  </ItemGroup>

</Project>
